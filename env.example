# ── Aplicación ───────────────────────────────────────────────────────────────
PDF_MAX_SIZE_MB=5
LOG_LEVEL=DEBUG
CORS_ORIGINS=["*"]
TZ=America/Argentina/Buenos_Aires

# ── Red compartida entre todos los Compose ───────────────────────────────────
SHARED_NETWORK_NAME=test_network

# URLs internas por alias de servicio Docker.
PDF_EXTRACT_SERVICE_URL=http://api:8080
DB_SERVICE_URL=http://microservicio-db-go:8080
DB_SERVICE_TIMEOUT_SECONDS=10.0

# ── Traefik / ruteo ─────────────────────────────────────────────────────────
# Host que Traefik usa para enrutar hacia la app (router Rule).
# Si lo cambiás, agregalo también a ALLOWED_HOSTS.
DOMAIN_HOST=api.localhost

# Hosts permitidos por TrustedHostMiddleware (opcional; el default ya incluye
# api.localhost, localhost, 127.0.0.1 y testserver). Formato JSON array.
# ALLOWED_HOSTS=["api.localhost","localhost","127.0.0.1"]

# ── MongoDB (gestionado por microservicio-db-go) ──────────────────────────────
MONGO_USER=admin
MONGO_PASSWORD=password
