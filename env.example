# Root environment variables for all docker-compose stacks
# Generated for local development

# Consul
CONSUL_BOOTSTRAP_TOKEN=dev-bootstrap-token
SHARED_NETWORK_NAME=test_network

# MongoDB
MONGO_USER=admin
MONGO_PASSWORD=password
MONGODB_DB=pdf_db
MONGODB_COLLECTION=extracted_texts

# General
TZ=UTC
PDF_MAX_SIZE_MB=25
DB_SERVICE_TIMEOUT_SECONDS=10.0

# Consul addresses (used by all services)
CONSUL_HTTP_ADDR=consul:8500
CONSUL_HTTP_TOKEN=dev-bootstrap-token
CONSUL_DNS_PORT=8600
CONSUL_DISCOVERY_CACHE_TTL=30

# Consul Connect sidecar ports
CONNECT_SIDECAR_PORT_GO=8443
CONNECT_SIDECAR_PORT_DB=8444

# Routing hosts (Traefik via Consul Catalog)
DOMAIN_HOST=api.localhost
MICROSERVICE_HOST=extract.localhost

# Microservicio-go (PDF Extractor)
GIN_MODE=release
MAX_UPLOAD_MB=25
REDIS_URL=redis://redis:6379
CACHE_TTL=24h
REDIS_TIMEOUT=2s
CONCURRENCY=0
QUEUE_SIZE=200
MAX_IN_FLIGHT=8
ADMISSION_TIMEOUT=2s
EXTRACTION_TIMEOUT=30s
GOMEMLIMIT=850MiB
GOGC=150

# Microservicio-db (Document CRUD)
ERR_BASE_URL=https://errors.example.com
MAX_IN_FLIGHT=32
REQUEST_TIMEOUT=10s
SHUTDOWN_TIMEOUT=15s
PORT=8080